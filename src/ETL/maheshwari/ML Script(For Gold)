ML Script for Gold:-
import sys
from awsglue.transforms import *
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext
from awsglue.context import GlueContext
from awsglue.job import Job
from pyspark.sql.functions import *
from pyspark.sql.types import FloatType
from pyspark.sql.window import Window

args = getResolvedOptions(sys.argv, ["JOB_NAME"])
sc = SparkContext()
glueContext = GlueContext(sc)
spark = glueContext.spark_session
job = Job(glueContext)
job.init(args["JOB_NAME"], args)

# ============================================================
# BUCKET NAME
# ============================================================
BUCKET = "yelpdatasetvita"

# ============================================================
# 1. READ 4 SILVER FOLDERS SEPARATELY
# ============================================================
business_df = spark.read.parquet(f"s3://{BUCKET}/silver_layer/business/")
user_df     = spark.read.parquet(f"s3://{BUCKET}/silver_layer/user/")
review_df   = spark.read.parquet(f"s3://{BUCKET}/silver_layer/review/")
checkin_df  = spark.read.parquet(f"s3://{BUCKET}/silver_layer/checkin/")

print("business columns:", business_df.columns)
print("user columns:", user_df.columns)
print("review columns:", review_df.columns)
print("checkin columns:", checkin_df.columns)

# ============================================================
# 2. SELECT + RENAME OVERLAPPING COLUMNS BEFORE JOIN
# ============================================================
business_r = business_df.select(
    col("business_id"),
    col("name").alias("business_name"),
    col("categories"),
    col("city"),
    col("state"),
    col("stars").alias("business_stars"),
    col("review_count").alias("business_review_count")
)

user_r = user_df.select(
    col("user_id"),
    col("review_count").alias("user_review_count"),
    col("elite")
)

review_r = review_df.select(
    col("review_id"),
    col("user_id"),
    col("business_id"),
    col("stars"),
    col("text"),
    col("date")
)

# ============================================================
# 3. JOIN -> build merged dataframe (equivalent to old "merged_data")
# ============================================================
df = (
    review_r
    .join(user_r, on="user_id", how="left")
    .join(business_r, on="business_id", how="left")
)

print("Joined DataFrame columns:", df.columns)
print("Row count:", df.count())
df.printSchema()

# ============================================================
# BRANCH 1: SENTIMENT DATASET
# ============================================================
print("\n=== Processing SENTIMENT Dataset ===")

sentiment_df = df.select(
    col("review_id"),
    col("user_id"),
    col("stars").cast(FloatType()).alias("stars"),
    col("text").alias("review_text"),
    col("date").alias("review_date"),
    col("user_review_count"),
    col("elite")
).distinct()

sentiment_df = sentiment_df.withColumn(
    "is_elite",
    when((col("elite").isNotNull()) & (col("elite") != ""), 1).otherwise(0)
)

sentiment_df = sentiment_df.withColumn(
    "genuity_score",
    col("stars") *
    log1p(coalesce(col("user_review_count"), lit(0))) *
    (1 + col("is_elite") * 0.2)
).withColumn(
    "sentiment_label",
    when(col("stars") >= 4, "positive")
    .when(col("stars") == 3, "neutral")
    .otherwise("negative")
)

sentiment_final = sentiment_df.select(
    "review_id", "stars", "review_text", "review_date",
    "genuity_score", "sentiment_label", "user_id"
)

sentiment_final.coalesce(1).write.mode("overwrite").parquet(
    f"s3://{BUCKET}/gold_layer/ml/sentiment/"
)
print("✓ Sentiment data written to S3")

# ============================================================
# BRANCH 2: COLLABORATIVE FILTERING DATASET
# ============================================================
print("\n=== Processing COLLABORATIVE FILTERING Dataset ===")

collab_df = df.select(
    "user_id",
    "business_id",
    col("stars").cast(FloatType()).alias("stars"),
    col("user_review_count")
).distinct().filter(col("stars").isNotNull())

# Build numeric indices using dense_rank() instead of StringIndexer.
# StringIndexer.fit() collects/sorts all distinct values on the driver,
# which caused a "Buffer overflow" error on large datasets with G.1X workers.
# dense_rank() over a Window does the same job fully distributed, no driver collect.
user_window = Window.orderBy("user_id")
business_window = Window.orderBy("business_id")

collab_df = collab_df.withColumn("user_idx", dense_rank().over(user_window) - 1)
collab_df = collab_df.withColumn("business_idx", dense_rank().over(business_window) - 1)

collab_final = collab_df.select(
    "user_id",
    "business_id",
    col("stars").alias("rating"),
    "user_idx",
    "business_idx"
)

collab_final.coalesce(1).write.mode("overwrite").parquet(
    f"s3://{BUCKET}/gold_layer/ml/collaborative/"
)
print("✓ Collaborative filtering data written to S3")

# ============================================================
# BRANCH 3: CONTENT-BASED DATASET
# ============================================================
print("\n=== Processing CONTENT-BASED Dataset ===")

content_df = df.select(
    "business_id",
    "business_name",
    "categories",
    "city",
    "state",
    col("business_stars").cast(FloatType()).alias("business_stars"),
    "business_review_count"
).dropDuplicates(["business_id"])

content_df = content_df.withColumn(
    "categories_list",
    split(col("categories"), ",")
)

content_final = content_df.select(
    "business_id",
    col("business_name").alias("name"),
    col("categories_list").alias("categories"),
    "city",
    "state",
    col("business_stars").alias("avg_rating"),
    col("business_review_count").alias("review_count")
)

content_final.coalesce(1).write.mode("overwrite").parquet(
    f"s3://{BUCKET}/gold_layer/ml/content_based/"
)
print("✓ Content-based data written to S3")

# ============================================================
# Summary
# ============================================================
print("\n" + "="*60)
print("✅ GOLD_ML JOB COMPLETED SUCCESSFULLY")
print("="*60)
print(f"Sentiment records: {sentiment_final.count()}")
print(f"Collaborative records: {collab_final.count()}")
print(f"Content records: {content_final.count()}")

job.commit()











